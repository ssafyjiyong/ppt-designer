FROM python:3.12-slim-bookworm

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libreoffice-impress \
        fonts-noto-cjk \
        fonts-noto-cjk-extra \
        poppler-utils \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir awslambdaric

ENV LAMBDA_TASK_ROOT=/var/task
WORKDIR ${LAMBDA_TASK_ROOT}

COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

COPY shared/ ${LAMBDA_TASK_ROOT}/shared/
COPY functions/sf_render_previews.py ${LAMBDA_TASK_ROOT}/functions/
COPY functions/__init__.py ${LAMBDA_TASK_ROOT}/functions/

ENV HOME=/tmp
RUN mkdir -p /tmp/.cache && \
    soffice --headless --nologo --norestore --terminate_after_init || true

ENTRYPOINT ["/usr/local/bin/python", "-m", "awslambdaric"]
CMD ["functions.sf_render_previews.handler"]
